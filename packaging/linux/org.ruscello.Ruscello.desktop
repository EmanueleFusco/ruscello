[Desktop Entry]
Name=Ruscello Download Manager
Comment=Manage downloads and torrents
Comment[it]=Gestisci download e torrent
Exec=ruscello %U
Icon=ruscello
StartupWMClass=org.ruscello.Ruscello
Terminal=false
Type=Application
Categories=Network;FileTransfer;
MimeType=application/x-bittorrent;application/x-dlc;x-scheme-handler/magnet;
